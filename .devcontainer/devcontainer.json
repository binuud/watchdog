{
  "name": "Go Docker Dev Environment with GoPls",
  "image": "dronasys-com/golang:1.27.1",
  "runArgs": [
    "--name", "golang-dev-vscode",
    "-p", "9080:9080",
    "-p", "9090:9090"
  ],
  // Automatically installs the official Go extension inside the container
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  // Mount local workspace folders into the container
  "workspaceMount": "source=${env:HOME}/Code,target=/app/Code,type=bind",
  "workspaceFolder": "/app",
  // Use 'remoteUser' if you need to run as a non-root user
  "remoteUser": "root"
}